# Copy this file to ".env" for your own settings. ".env" is never uploaded to GitHub
# (see .gitignore). Never put real passwords in .env.example itself.

# Admin account.
# - On your own computer you can leave these empty: the first time you open the
#   dashboard it asks you to create an admin account.
# - On a server (or HOST=0.0.0.0) they are required, so nobody else can claim the
#   first account. The app refuses to start without them in that case.
# This account always uses ADMIN_PASSWORD, so setting it is also how you get back
# in if you forget your password. Add more people in Settings > Accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port the dashboard listens on: http://localhost:3000
PORT=3000

# 127.0.0.1 = only this computer can open the dashboard (safest).
# 0.0.0.0   = other devices / the internet can reach it. Set ADMIN_PASSWORD first.
HOST=127.0.0.1

# Default timezone for new installs. You can also change it later in Settings.
# Examples: Asia/Kuala_Lumpur, Asia/Singapore, Asia/Hong_Kong, Europe/London
# TZ=Asia/Kuala_Lumpur

# Where the WhatsApp login, schedules and inbox history are stored.
# DATA_DIR=./data

# Log detail: info (default) or debug. BAILEYS_LOG_LEVEL controls the WhatsApp library itself.
# LOG_LEVEL=info
# BAILEYS_LOG_LEVEL=warn
